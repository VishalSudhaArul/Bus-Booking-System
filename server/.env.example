# ── Database ────────────────────────────────────────────────────────────────
# Paste your MongoDB Atlas connection string here (never commit the real one).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/busnest?retryWrites=true&w=majority
# Database name (used even if the URI has no /database path)
MONGODB_DB_NAME=busnest
# auto = detect replica set / mongos at startup, on = always, off = never
MONGODB_TRANSACTIONS=auto

# ── Auth ────────────────────────────────────────────────────────────────────
# Each secret must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional extra allowed origins, comma separated
CORS_ORIGINS=
# Cross-site deployments (Vercel -> Render) need COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# ── Business rules ──────────────────────────────────────────────────────────
BOOKING_MAX_SEATS=6
GST_PERCENT=5
# Cancellation is refused inside the cut-off window (hours before departure).
CANCELLATION_CUTOFF_HOURS=2
# JSON array, highest minHours first. refundPercent 100 = full, 0 = no refund.
CANCELLATION_TIERS=[{"minHours":48,"refundPercent":100},{"minHours":24,"refundPercent":75},{"minHours":12,"refundPercent":50},{"minHours":0,"refundPercent":0}]
